+from django.http import HttpRequest  # noqa: TC002 - required at runtime by Django
+
+from ninja import Router
+
+from accounts.api.security import AuthBearer
+from schedules.models import ScheduledJob
+
+schedules_router = Router(auth=AuthBearer(), tags=["schedules"])
+
+
+@schedules_router.get("/{schedule_id}/export", response={200: dict, 404: dict})
+async def export_schedule(request: HttpRequest, schedule_id: int):
+    """Return a schedule's settings as JSON."""
+    queryset = ScheduledJob.objects.by_owner(request.auth).select_related("sandbox_environment")
+    try:
+        schedule = await queryset.aget(pk=schedule_id)
+    except ScheduledJob.DoesNotExist:
+        return 404, {"detail": "Schedule not found"}
+
+    return 200, {
+        "name": schedule.name,
+        "prompt": schedule.prompt,
+        "repos": schedule.repos,
+        "frequency": schedule.frequency,
+        "cron_expression": schedule.cron_expression,
+        "time": schedule.time.isoformat() if schedule.time else None,
+        "run_at": schedule.run_at.isoformat() if schedule.run_at else None,
+        "agent_model": schedule.agent_model,
+        "agent_thinking_level": schedule.agent_thinking_level,
+        "muted": schedule.muted,
+        "intent": schedule.intent,
+        "mcp_overrides": schedule.mcp_overrides,
+        "sandbox_environment": schedule.sandbox_environment.name if schedule.sandbox_environment else None,
+        "subscribers": [user.email async for user in schedule.subscribers.all()],
+    }
