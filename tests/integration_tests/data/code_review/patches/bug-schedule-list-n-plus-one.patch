+def _attach_last_run_status(schedules) -> None:
+    """Set ``last_run_status`` on each schedule: the status of the newest run of its last batch.
+
+    ``None`` for a schedule that never fired or whose batch rows were purged.
+    """
+    for schedule in schedules:
+        if schedule.last_run_batch_id is None:
+            schedule.last_run_status = None
+            continue
+        latest = Run.objects.by_batch(schedule.last_run_batch_id).order_by("-created_at", "-id").only("status").first()
+        schedule.last_run_status = latest.status if latest else None
+
