+
+
+class ScheduleExportView(LoginRequiredMixin, View):
+    """Download a schedule's configuration as JSON, to recreate it elsewhere or attach to a report."""
+
+    http_method_names = ["get"]
+
+    def get(self, request, pk):
+        schedule = get_object_or_404(
+            ScheduledJob.objects.select_related("sandbox_environment").prefetch_related("subscribers"), pk=pk
+        )
+        payload = {
+            "name": schedule.name,
+            "prompt": schedule.prompt,
+            "repos": schedule.repos,
+            "frequency": schedule.frequency,
+            "cron_expression": schedule.cron_expression,
+            "time": schedule.time.isoformat() if schedule.time else None,
+            "agent_model": schedule.agent_model,
+            "agent_thinking_level": schedule.agent_thinking_level,
+            "mcp_overrides": schedule.mcp_overrides,
+            "sandbox_environment": schedule.sandbox_environment.name if schedule.sandbox_environment else None,
+            "subscribers": [user.email for user in schedule.subscribers.all()],
+        }
+        response = HttpResponse(json.dumps(payload, indent=2), content_type="application/json")
+        response["Content-Disposition"] = f'attachment; filename="schedule-{schedule.pk}.json"'
+        return response
