+def _attach_last_run_status(schedules) -> None:
+    """Set ``last_run_status`` on each schedule: the status of the newest run of its last batch.
+
+    ``None`` for a schedule that never fired or whose batch rows were purged. One query for
+    the whole page.
+    """
+    batch_ids = [schedule.last_run_batch_id for schedule in schedules if schedule.last_run_batch_id is not None]
+    latest_by_batch: dict = {}
+    runs = Run.objects.filter(batch_id__in=batch_ids).order_by("batch_id", "-created_at").only("batch_id", "status")
+    for run in runs:
+        latest_by_batch.setdefault(run.batch_id, run.status)
+    for schedule in schedules:
+        schedule.last_run_status = latest_by_batch.get(schedule.last_run_batch_id)
+
+
 class ScheduleListView(_ScheduleOwnerMixin, LoginRequiredMixin, ListView):
