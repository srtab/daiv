+async def _job_merge_request(run: Run) -> JobMergeRequest | None:
+    """The merge request a job's changes live on.
+
+    A run that pushed to a branch which already had an open merge request records no URL of its
+    own, so the open merge request on the run's branch is looked up first and the run's own URL
+    is the fallback.
+    """
+    if not run.code_changes:
+        return None
+    payload = await aget_existing_mr_payload(run.ref, run.repo_id)
+    if payload is not None:
+        return JobMergeRequest(**payload)
+    if run.merge_request_web_url:
+        return JobMergeRequest(id=run.merge_request_iid, url=run.merge_request_web_url)
+    return None
+
