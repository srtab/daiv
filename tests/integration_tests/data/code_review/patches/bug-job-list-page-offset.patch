+@jobs_router.get("", response=JobListResponse)
+async def list_jobs(
+    request: HttpRequest, page: int = 1, page_size: int = DEFAULT_PAGE_SIZE, repo_id: str | None = None
+):
+    """List the caller's jobs, newest first, one page at a time.
+
+    ``page`` is 1-based and ``page_size`` is capped at ``MAX_PAGE_SIZE``. ``has_more`` tells
+    whether requesting ``page + 1`` returns anything.
+    """
+    page = max(page, 1)
+    page_size = max(1, min(page_size, MAX_PAGE_SIZE))
+    qs = Run.objects.filter(user=request.auth)
+    if repo_id:
+        qs = qs.filter(repo_id=repo_id)
+    qs = qs.order_by("-created_at", "-id")
+
+    start = page * page_size
+    rows = [run async for run in qs[start : start + page_size + 1]]
+    jobs = [
+        JobListItem(
+            job_id=str(run.id),
+            repo_id=run.repo_id,
+            ref=run.ref or None,
+            status=cast("Literal['QUEUED', 'READY', 'RUNNING', 'SUCCESSFUL', 'WAITING_INPUT', 'FAILED']", run.status),
+            created_at=run.created_at,
+        )
+        for run in rows[:page_size]
+    ]
+    return JobListResponse(jobs=jobs, page=page, has_more=len(rows) > page_size)
+
+
