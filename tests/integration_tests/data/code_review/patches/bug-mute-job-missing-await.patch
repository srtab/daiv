diff --git a/daiv/mcp_api/server.py b/daiv/mcp_api/server.py
--- a/daiv/mcp_api/server.py
+++ b/daiv/mcp_api/server.py
@@ -491,6 +491,37 @@
     if mcp_user is None:
         return None, {"error": "Authentication failed: unable to resolve the current user."}
     return mcp_user, None
+
+
+@mcp.tool()
+async def mute_job(
+    job_id: Annotated[str, Field(description="The job ID returned by submit_job.")],
+    muted: Annotated[bool, Field(description="True silences this job's notifications; false restores them.")] = True,
+) -> dict:
+    """Mute or unmute the notifications of one of the caller's jobs.
+
+    Set the stored notification override, including while a finished run awaits delivery.
+    Notifications already delivered are not retracted.
+    Returns ``{"job_id": str, "muted": bool}``.
+    """
+    mcp_user, auth_error = await _resolve_mcp_user()
+    if auth_error is not None:
+        return auth_error
+
+    try:
+        run_uuid = uuid_mod.UUID(job_id)
+    except ValueError:
+        return {"error": "Invalid job_id format."}
+
+    try:
+        run = await Run.objects.aget(id=run_uuid, user=mcp_user)
+    except Run.DoesNotExist:
+        return {"error": "Job not found."}
+
+    run.muted = muted
+    run.asave(update_fields=["muted"])
+    logger.info("Job %s muted=%s", run.id, muted)
+    return {"job_id": str(run.id), "muted": run.muted}
 
 
