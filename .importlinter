[importlinter]
root_packages =
    accounts
    automation
    chat
    codebase
    configuration
    core
    daiv
    dashboard
    jobs
    mcp_api
    mcp_connectors
    memory
    notifications
    plugins
    sandbox_envs
    schedules
    sessions
    skills
    slash_commands
    webhooks
exclude_type_checking_imports = True

[importlinter:contract:core]
name = core imports no other app
type = forbidden
source_modules = core
forbidden_modules =
    accounts
    automation
    chat
    codebase
    configuration
    dashboard
    jobs
    mcp_api
    mcp_connectors
    memory
    notifications
    plugins
    sandbox_envs
    schedules
    sessions
    skills
    slash_commands
    webhooks
allow_indirect_imports = True

[importlinter:contract:sandbox-envs]
name = sandbox_envs sits beside codebase, below the agent
type = forbidden
source_modules = sandbox_envs
forbidden_modules =
    accounts
    automation
    chat
    codebase
    configuration
    dashboard
    jobs
    mcp_api
    mcp_connectors
    memory
    notifications
    plugins
    schedules
    sessions
    skills
    slash_commands
    webhooks
allow_indirect_imports = True

[importlinter:contract:codebase]
name = codebase is platform access only
type = forbidden
source_modules = codebase
forbidden_modules =
    accounts
    automation
    chat
    configuration
    dashboard
    jobs
    mcp_api
    mcp_connectors
    memory
