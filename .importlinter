[importlinter]
root_packages =
    accounts
    automation
    chat
    codebase
    configuration
    core
    daiv
    jobs
    mcp_server
    mcp_servers
    memory
    notifications
    sandbox_envs
    schedules
    sessions
    skills
    slash_commands
    webhooks
exclude_type_checking_imports = True

[importlinter:contract:core]
name = core imports no other app
type = forbidden
source_modules = core
forbidden_modules =
    accounts
    automation
    chat
    codebase
    configuration
    jobs
    mcp_server
    mcp_servers
    memory
    notifications
    sandbox_envs
    schedules
    sessions
    skills
    slash_commands
    webhooks
allow_indirect_imports = True

[importlinter:contract:sandbox-envs]
name = sandbox_envs sits below codebase and the agent
type = forbidden
source_modules = sandbox_envs
forbidden_modules =
    automation
    chat
    codebase
    configuration
    jobs
    mcp_server
    memory
    notifications
    schedules
    sessions
    webhooks
allow_indirect_imports = True

[importlinter:contract:codebase]
name = codebase is platform access only
type = forbidden
source_modules = codebase
forbidden_modules =
    automation
    chat
    configuration
    jobs
    mcp_server
    schedules
    sessions
    webhooks
allow_indirect_imports = True

[importlinter:contract:agent]
name = the agent does not import runs or triggers
type = forbidden
source_modules = automation
forbidden_modules =
    chat
    configuration
    jobs
    mcp_server
    schedules
    sessions
    webhooks
allow_indirect_imports = True
ignore_imports =
    automation.agent.middlewares.artifacts -> sessions.artifacts
    automation.agent.middlewares.artifacts -> sessions.conf
    automation.titling.tasks -> sessions.models

[importlinter:contract:sessions]
name = sessions does not import trigger apps
type = forbidden
source_modules = sessions
forbidden_modules =
    chat
    configuration
    jobs
    mcp_server
    webhooks
allow_indirect_imports = True
