[importlinter:contract:agent]
name = the agent sits below connectors, runs and triggers
type = forbidden
source_modules = automation
forbidden_modules =
    chat
    configuration
    dashboard
    jobs
    mcp_api
    mcp_connectors
    memory
    notifications
    schedules
    sessions
    webhooks
# Known upward edge: the memory middleware loads RepositoryMemory into the prompt.
ignore_imports =
    automation.agent.middlewares.memory -> memory.models
allow_indirect_imports = True

[importlinter:contract:mcp-connectors]
name = mcp_connectors sits below runs and triggers
type = forbidden
source_modules = mcp_connectors
forbidden_modules =
    chat
    configuration
    dashboard
    jobs
    mcp_api
    memory
    notifications
    schedules
    sessions
    webhooks
allow_indirect_imports = True

[importlinter:contract:sessions]
name = sessions sits below memory, schedules, notifications and triggers
type = forbidden
source_modules = sessions
forbidden_modules =
    chat
    configuration
    dashboard
    jobs
    mcp_api
    memory
    notifications
    schedules
    webhooks
# One-release alias for task rows queued before classification moved to notifications.
ignore_imports =
    sessions.tasks -> notifications.tasks
allow_indirect_imports = True

[importlinter:contract:memory]
name = memory does not import schedules, notifications or triggers
type = forbidden
source_modules = memory
forbidden_modules =
    chat
    configuration
    dashboard
    jobs
    mcp_api
    notifications
    schedules
    webhooks
allow_indirect_imports = True

[importlinter:contract:schedules]
name = schedules does not import memory, notifications or triggers
