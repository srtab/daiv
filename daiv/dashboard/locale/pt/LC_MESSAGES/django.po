msgid "Spend over time"
msgstr "Gastos ao longo do tempo"

#, python-format
msgid "\"Cache hits\" is the prompt cache hit rate: the share of the input tokens the provider served from its cache instead of reading them again at full price. <span class=\"text-status-clear\">Green</span> is %(good)s%% or more, grey %(fair)s%% or more, <span class=\"text-status-found\">amber</span> under %(fair)s%%."
msgstr "\"Acertos na cache\" é a taxa de acertos da cache de prompts: a parte dos tokens de entrada que o fornecedor serviu a partir da sua cache em vez de os ler novamente ao preço total. <span class=\"text-status-clear\">Verde</span> é %(good)s%% ou mais, cinzento %(fair)s%% ou mais, <span class=\"text-status-found\">âmbar</span> abaixo de %(fair)s%%."

msgid "Most expensive sessions"
