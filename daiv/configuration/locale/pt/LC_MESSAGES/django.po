#, python-format
msgid "Default (%(name)s)"
msgstr "Predefinição (%(name)s)"

msgid "Pick a model"
msgstr "Selecionar um modelo"

msgid "Locked by environment variable"
msgstr "Bloqueado por variável de ambiente"

#, python-format
msgid "Unsupported model: %(m)s."
msgstr "Modelo não suportado: %(m)s."

#, python-format
msgid "Provider '%(s)s' is not configured."
msgstr "O fornecedor '%(s)s' não está configurado."

#, python-format
msgid "Provider '%(s)s' is disabled. Enable it in the Providers section."
msgstr "O fornecedor '%(s)s' está desativado. Ative-o na secção Fornecedores."

#, python-format
msgid "Provider '%(s)s' has no API key. Set it in the Providers section."
msgstr "O fornecedor '%(s)s' não tem chave API. Defina-a na secção Fornecedores."

msgid "Tavily requires an API key. Set the web search API key below or via environment variable."
msgstr "O Tavily requer uma chave API. Defina a chave API de pesquisa web abaixo ou através de variável de ambiente."

msgid "OAuth requires both a client ID and a client secret."
msgstr "O OAuth requer um client ID e um client secret."

#, python-format
msgid "Telegram rejected this bot token: %(err)s"
msgstr "O Telegram rejeitou este token de bot: %(err)s"

msgid "Could not reach Telegram to verify the bot token; it was saved unverified."
msgstr "Não foi possível contactar o Telegram para verificar o token do bot; foi guardado sem verificação."

msgid "Could not verify the bot token; it was saved unverified. Check the server logs."
msgstr "Não foi possível verificar o token do bot; foi guardado sem verificação. Consulte os registos do servidor."

msgid "API key for Tavily web search engine."
msgstr "Chave API do motor de pesquisa web Tavily."

msgid "API key for the sandbox service."
msgstr "Chave API do serviço de sandbox."

msgid "OAuth application client secret for the configured Git platform."
msgstr "Client secret da aplicação OAuth para a plataforma Git configurada."

msgid "Bot user personal access token (X-Auth-Token)."
msgstr "Token de acesso pessoal do utilizador do bot (X-Auth-Token)."

msgid "Bot token issued by @BotFather, in the form 123456:ABC-DEF."
msgstr "Token do bot emitido pelo @BotFather, no formato 123456:ABC-DEF."

msgid "header value"
msgstr "valor do cabeçalho"

msgid "Domain"
msgstr "Domínio"

msgid "Header name"
msgstr "Nome do cabeçalho"

msgid "Header value"
msgstr "Valor do cabeçalho"

msgid "Enter a host only (e.g. example.com)."
msgstr "Introduza apenas um host (ex.: example.com)."

msgid "Use letters, digits, and hyphens only (e.g. X-API-Key)."
msgstr "Use apenas letras, dígitos e hífenes (ex.: X-API-Key)."

msgid "Required."
msgstr "Obrigatório."

#, python-format
msgid "Duplicate (domain, header name) pair: %(domain)s / %(header)s."
msgstr "Par (domínio, nome do cabeçalho) duplicado: %(domain)s / %(header)s."

msgid "API key"
msgstr "Chave API"

msgid "Extra headers (JSON)"
msgstr "Cabeçalhos extra (JSON)"

msgid "Use Responses API"
msgstr "Usar Responses API"

msgid "Verify TLS certificates"
msgstr "Verificar certificados TLS"

msgid "'google' is a reserved alias."
msgstr "'google' é um alias reservado."

msgid "Slug must start with a lowercase letter; lowercase letters, digits, '-' and '_'; max 32 chars."
msgstr "O slug tem de começar por uma letra minúscula; letras minúsculas, dígitos, '-' e '_'; máximo 32 caracteres."

msgid "Slug is immutable after creation; delete and re-add to change."
msgstr "O slug é imutável após a criação; elimine e volte a adicionar para o alterar."

msgid "Locked provider; provider type cannot be changed."
msgstr "Fornecedor bloqueado; o tipo de fornecedor não pode ser alterado."

msgid "Base URL must use http or https."
msgstr "O URL base tem de usar http ou https."

msgid "Base URL looks like it is missing a version segment (e.g. '/v1'). The OpenAI SDK appends paths verbatim, so requests may hit the wrong route."
msgstr "O URL base parece não ter um segmento de versão (ex.: '/v1'). O SDK da OpenAI acrescenta os caminhos tal como estão, pelo que os pedidos podem chegar à rota errada."

msgid "verify_ssl=False has no effect for this provider type — the SDK doesn't accept a custom HTTP client. Mount the CA into the daiv containers instead."
msgstr "verify_ssl=False não tem efeito para este tipo de fornecedor — o SDK não aceita um cliente HTTP personalizado. Em vez disso, monte a CA nos contentores do daiv."

#, python-format
msgid "Invalid JSON: %s"
msgstr "JSON inválido: %s"

msgid "Extra headers must be a JSON object."
msgstr "Os cabeçalhos extra têm de ser um objeto JSON."

#, python-format
msgid "Invalid header name: %s"
msgstr "Nome de cabeçalho inválido: %s"

#, python-format
msgid "Header value for %s must be a string."
msgstr "O valor do cabeçalho para %s tem de ser uma string."

msgid "Required when enabled."
msgstr "Obrigatório quando ativado."

#, python-format
msgid "Locked provider '%s' cannot be deleted."
msgstr "O fornecedor bloqueado '%s' não pode ser eliminado."

#, python-format
msgid "Duplicate slug: %s"
msgstr "Slug duplicado: %s"

msgid "Configuration section"
msgstr ""

msgid "Section"
msgstr ""

msgid "Configure model providers. Reach a model from agent config via the form"
msgstr "Configure os fornecedores de modelos. Alcance um modelo a partir da configuração do agente através do formulário"

msgid "Providers could not be saved — please fix the errors below:"
msgstr "Não foi possível guardar os fornecedores — corrija os erros abaixo:"

msgid "new row"
msgstr "nova linha"

msgid "Built-in"
msgstr "Integrado"

msgid "Custom"
msgstr "Personalizado"

msgid "Add custom provider"
msgstr "Adicionar fornecedor personalizado"

msgid "Telegram bot username"
msgstr "Nome de utilizador do bot do Telegram"

msgid "Not derived yet — save this group with a valid bot token, or wait for the next reconcile."
msgstr "Ainda não obtido — guarde este grupo com um token de bot válido, ou aguarde a próxima sincronização."

msgid "Read from Telegram with getMe, not typed. The connect link on the notification channels page needs it."
msgstr "Lido do Telegram com getMe, não escrito à mão. O link de ligação na página de canais de notificação precisa dele."

msgid "Per-domain auth headers"
msgstr "Cabeçalhos de autenticação por domínio"

msgid "Send custom HTTP headers when web_fetch contacts a domain. Match is exact (no subdomains)."
msgstr "Enviar cabeçalhos HTTP personalizados quando o web_fetch contacta um domínio. A correspondência é exata (sem subdomínios)."

msgid "No headers configured via DAIV_WEB_FETCH_AUTH_HEADERS."
msgstr "Nenhum cabeçalho configurado através de DAIV_WEB_FETCH_AUTH_HEADERS."

msgid "Add header"
msgstr "Adicionar cabeçalho"

msgid "Reorder"
msgstr "Reordenar"

msgid "New provider"
msgstr "Novo fornecedor"

msgid "API key set"
msgstr "Chave API definida"

msgid "key set"
msgstr "chave definida"

msgid "API key missing"
msgstr "Chave API em falta"

msgid "no key"
msgstr "sem chave"

msgid "Enabled"
msgstr "Ativado"

msgid "Remove"
msgstr "Remover"

msgid "Base URL"
msgstr "URL base"

msgid "override"
msgstr "substituir"

msgid "Empty = SDK default. Useful for Azure / proxies."
msgstr "Vazio = predefinição do SDK. Útil para Azure / proxies."

msgid "Advanced"
msgstr "Avançado"

msgid "Display name"
msgstr "Nome de apresentação"

msgid "Provider type"
msgstr "Tipo de fornecedor"

msgid "Slug"
msgstr "Slug"

msgid "Slug is set at creation; delete and re-add to change."
msgstr "O slug é definido na criação; elimine e volte a adicionar para o alterar."

msgid "OpenAI-typed providers only. Enable for servers exposing /v1/responses; disable for /v1/chat/completions-only servers."
msgstr "Apenas para fornecedores do tipo OpenAI. Ative para servidores que expõem /v1/responses; desative para servidores apenas com /v1/chat/completions."

msgid "Disable only for self-hosted endpoints behind an internal/self-signed CA. Insecure — prefer mounting the CA into the daiv containers."
msgstr "Desative apenas para endpoints auto-alojados por detrás de uma CA interna/autoassinada. Inseguro — prefira montar a CA nos contentores do daiv."

msgid "Clear"
msgstr "Limpar"

msgid "Stored:"
msgstr "Armazenado:"

msgid "(new)"
msgstr "(novo)"

msgid "Telegram synchronisation failed; check the server logs."
msgstr "A sincronização com o Telegram falhou; consulte os registos do servidor."
