#, python-brace-format
msgid ""
"I stopped watching CI on this merge request: no result I could act on "
"arrived within {hours} hours. Mention me if you want another look."
msgstr ""
"Deixei de vigiar o CI neste merge request: não chegou nenhum resultado sobre"
" o qual pudesse agir dentro de {hours} horas. Mencione-me se quiser que "
"volte a analisar."

#, python-brace-format
msgid "I stopped watching CI on this merge request: {reason}."
msgstr "Deixei de vigiar o CI neste merge request: {reason}."

msgid "I could not find a change that would fix it"
msgstr "não consegui encontrar uma alteração que o corrigisse"

#, python-brace-format
msgid ""
"I stopped watching CI on this branch: the pipeline did not finish in a way I"
" can act on (status `{status}`). Re-run it or mention me if you want another"
" look."
msgstr ""
"Deixei de vigiar o CI neste ramo: o pipeline não terminou de uma forma sobre"
" a qual possa agir (estado `{status}`). Execute-o novamente ou mencione-me "
"se quiser que volte a analisar."

#, python-brace-format
msgid ""
"I stopped after {attempts} attempts and CI is still failing: {names}. "
"Pipeline: {url}"
msgstr ""
"Parei após {attempts} tentativas e o CI continua a falhar: {names}. "
"Pipeline: {url}"

