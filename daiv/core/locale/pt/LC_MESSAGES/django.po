msgstr "domínio"

msgid "header name"
msgstr "nome do cabeçalho"

msgid "web fetch auth header"
msgstr "cabeçalho de autenticação de obtenção web"

msgid "web fetch auth headers"
msgstr "cabeçalhos de autenticação de obtenção web"

msgid "slug"
msgstr "slug"

